digraph LogicalArchitecture {
  graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.55", ranksep="0.95", splines=ortho];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#1f2937", fillcolor="#f8fafc", margin="0.18,0.12"];
  edge [color="#475569", arrowsize=0.8, penwidth=1.1];

  subgraph cluster_app {
    label="app/";
    color="#93c5fd";
    style="rounded";
    app_ui [label="页面与导航", fillcolor="#e0f2fe"];
    app_api [label="API Client / Repository", fillcolor="#e0f2fe"];
  }

  subgraph cluster_backend {
    label="backend/";
    color="#86efac";
    style="rounded";
    api [label="FastAPI API", fillcolor="#dcfce7"];
    domain [label="认证 / 业务域", fillcolor="#dcfce7"];
    tryon [label="AI 试戴服务", fillcolor="#dcfce7"];
    metric [label="埋点与评测", fillcolor="#dcfce7"];
    nailclaw [label="趋势分析服务", fillcolor="#dcfce7"];
    storage [label="SQLite + DATA_DIR", fillcolor="#fee2e2"];
  }

  subgraph cluster_web {
    label="web-admin/";
    color="#93c5fd";
    style="rounded";
    web_ui [label="Admin UI", fillcolor="#e0f2fe"];
  }

  subgraph cluster_external {
    label="外部依赖";
    color="#fcd34d";
    style="rounded";
    bailian [label="大模型", fillcolor="#fef3c7"];
    content [label="redbook / XhsSkills", fillcolor="#fef3c7"];
  }

  app_ui -> app_api;
  app_api -> api;
  web_ui -> api;

  api -> domain;
  api -> tryon;
  api -> metric;
  api -> nailclaw;

  domain -> storage;
  metric -> storage;
  nailclaw -> storage;
  tryon -> bailian;
  nailclaw -> content;

  { rank=same; app_ui; web_ui; }
  { rank=same; api; }
  { rank=same; domain; tryon; metric; nailclaw; }
  { rank=same; storage; bailian; content; }
}
