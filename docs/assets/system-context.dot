digraph SystemContext {
  graph [rankdir=LR, bgcolor="white", pad="0.2", nodesep="0.5", ranksep="0.8"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, color="#1f2937", fillcolor="#f8fafc"];
  edge [color="#475569", arrowsize=0.8, penwidth=1.2];

  user [label="普通用户", fillcolor="#dbeafe"];
  merchant [label="商家管理员", fillcolor="#dbeafe"];
  operator [label="平台运营管理员", fillcolor="#dbeafe"];

  app [label="app/android\nAndroid 客户端", fillcolor="#e0f2fe"];
  web [label="web-admin\n后台前端", fillcolor="#e0f2fe"];
  backend [label="backend/api\nFastAPI 主服务", fillcolor="#dcfce7"];

  bailian [label="DashScope 百炼", fillcolor="#fef3c7"];
  content [label="redbook / XhsSkills\n社区内容源", fillcolor="#fef3c7"];
  storage [label="SQLite + DATA_DIR", fillcolor="#fee2e2"];

  user -> app;
  merchant -> web;
  operator -> web;
  app -> backend;
  web -> backend;
  backend -> bailian;
  backend -> content;
  backend -> storage;
}
