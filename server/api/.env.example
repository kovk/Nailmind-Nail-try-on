APP_NAME=Nail Mind API
ADDR=0.0.0.0
PORT=8080
DATABASE_URL=sqlite:////app/data/nailmind.db
DATA_DIR=/app/data
PUBLIC_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=*
DEMO_EMAIL=luna@nailmind.app
DEMO_PASSWORD=123456
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
WORKER_TOKEN=replace-with-a-long-random-worker-token
API_BASE_URL=http://nailmind-api:8080
POLL_INTERVAL_SECONDS=2
MODEL_DIR=/models
# Supports either /models/nail-seg.pt or the competition repo's original /models/best.pt
YOLO_MODEL_PATH=/models/nail-seg.pt
ENABLE_FALLBACK_RENDERER=true
